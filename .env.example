# 复制为 .env 后填写。.env 永远不提交，也不要把取值粘贴进任何对话或日志。
TUSHARE_TOKEN=
# 仅 T003（旧库盘点）需要，新系统的研究数据不使用 PostgreSQL
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=5432
LEGACY_DB_NAME=
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=
# 旧项目 reports 目录（T003 盘点体积用），例如 C:\Users\xxx\Desktop\量化\reports
LEGACY_REPORTS_DIR=
# 新系统数据根目录，建议放在空间充足的盘，例如 E:\perq_data
PERQ_DATA_DIR=
